{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["e2e/**/*.ts"]
    },
    "apps/server": {
      "entry": ["scripts/*.ts"]
    },
    "apps/web": {
      "entry": ["scripts/**/*.{ts,tsx,mjs}"]
    },
    "packages/*": {}
  }
}
