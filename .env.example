# Copier en .env (jamais versionné) et compléter. Toutes les variables :
# docs/operations/configuration.md

# Mot de passe PostgreSQL (obligatoire) : `openssl rand -hex 24`
POSTGRES_PASSWORD=

# URL publique (QR code de connexion des appareils), ex. https://questeo.exemple.fr
PUBLIC_URL=

# Port exposé sur la machine hôte
QUESTEO_PORT=3000

# Nombre de proxys de confiance devant le serveur (nginx : 1)
TRUST_PROXY=0

# Jeton exigé par /api/metrics (vide : métriques ouvertes, à réserver au réseau interne)
METRICS_TOKEN=

# E-mails (validation d'adresse) : Brevo, API transactionnelle. Obligatoire en production.
# Sans clé : simulation (lien journalisé) — jamais en production ; recette : APP_ENV=recette.
APP_ENV=
BREVO_API_KEY=
MAIL_FROM=

# « Continuer avec Google » (facultatif : bouton masqué si vide)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Par défaut : PUBLIC_URL + /api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=
