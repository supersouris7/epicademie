{
  "name": "@questeo/server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx src/cli/migrate.ts && tsx watch src/main.ts",
    "build": "node build.mjs",
    "typecheck": "tsc -p .",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/cli/migrate.ts",
    "db:check": "drizzle-kit check"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/static": "^10.1.11",
    "@fastify/swagger": "9.9.3",
    "@fastify/swagger-ui": "6.1.3",
    "@prometheus-io/client": "0.16.1",
    "@questeo/content": "workspace:*",
    "@questeo/engine": "workspace:*",
    "@questeo/shared": "workspace:*",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "7.0.0",
    "pg": "8.23.1",
    "socket.io": "^4.8.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@types/pg": "8.23.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "socket.io-client": "4.8.4",
    "tsx": "^4.23.15"
  },
  "files": [
    "dist",
    "drizzle"
  ]
}
